# ===== 敏感配置（永远不进仓库）=====
.env
.env.*
*.env
# 例外：.env.example 是密钥治理的模板文件，不含真实值，必须能提交（Day 23 修复：
# 上面的 .env.* 会把 .env.example 一起误杀，导致模板进不了仓库）
!.env.example
!ai-drama/.env.example

# CloudBase 部署配置：含环境 ID，属敏感信息，只留在本地
cloudbaserc.json

# ===== 密钥 / 证书 =====
*.pem
*.key
credentials.json
serviceAccountKey.json

# ===== 依赖目录（体积大，可重装）=====
node_modules/
vendor/

# ===== Python =====
__pycache__/
*.pyc
.venv/
venv/

# ===== 本地数据库 =====
*.sqlite
*.sqlite3
*.db

# ===== AI 漫剧：视频大文件不进仓库（外链嵌入，见 AGENTS.md）=====
ai-drama/assets/video/
*.mp4
*.mov
*.webm

# ===== 日志 =====
*.log
logs/

# ===== 系统文件 =====
.DS_Store
Thumbs.db
desktop.ini

# ===== 编辑器配置 =====
.vscode/
.idea/
*.swp
